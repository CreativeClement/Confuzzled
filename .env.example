# Optional. Confuzzle works without this: readers connect their own key in Settings,
# and it stays in their browser. Set a key here only if you want this deployment to
# decipher for readers who have no key of their own.
CONFUZZLE_API_KEY=
# openai | groq | openrouter | custom
CONFUZZLE_PROVIDER=openai
# Leave blank to use the provider's default model.
CONFUZZLE_MODEL=
# Only for CONFUZZLE_PROVIDER=custom, e.g. https://example.com/v1
CONFUZZLE_BASE_URL=

# Legacy alias, still read when CONFUZZLE_API_KEY is unset.
OPENAI_API_KEY=

NEXT_PUBLIC_SITE_URL=http://localhost:3000
